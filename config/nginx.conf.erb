daemon off;
error_log /dev/stderr;
worker_processes auto;

events {
  use epoll;
  accept_mutex on;
  worker_connections 1024;
}

http {
  gzip on;
  gzip_comp_level 2;
  gzip_min_length 512;
  gzip_proxied any;

  server_tokens off;
  charset utf-8;

  access_log /dev/stdout;
  error_log /dev/stderr;

  include mime.types;
  default_type application/octet-stream;
  sendfile on;

  client_body_timeout 5;
  client_header_timeout 5;

  # Rate limiting zone: 10 req/s per IP, burst 20
  limit_req_zone $binary_remote_addr zone=exploit:10m rate=10r/s;

  # Block known exploit bots / scanners by user-agent
  map $http_user_agent $bad_bot {
    default 0;

    # Vulnerability scanners
    ~*(sqlmap|nikto|masscan|acunetix|netsparker|nessus|openvas|appscan) 1;
    ~*(nmap|zgrab|wpscan|joomscan|dirbuster|gobuster|wfuzz) 1;
    ~*(burpcollaborator|nessus|nessus|core-nexpose|qualys) 1;

    # Generic exploit toolkits
    ~*(metasploit|pyload|urllib|python-requests|python-httpx) 1;
    ~*(go-http-client|Java/|libwww-perl|WWW-Mechanize) 1;
    ~*(ruby|curl|wget) 1;

    # Bad crawlers
    ~*(Semrush|AhrefsBot|MegaIndex|DotBot|MJ12bot) 1;
  }

  upstream app_server {
    server 127.0.0.1:<%= ENV["PORT"].to_i + 1 %> fail_timeout=0;
  }

  server {
    listen <%= ENV["PORT"] %>;
    server_name _;
    keepalive_timeout 5;

    # Force HTTPS
    if ($http_x_forwarded_proto != "https") {
      return 301 https://$host$request_uri;
    }

    # Reject exploit bots
    if ($bad_bot) {
      return 444;
    }

    # Rate limit all requests
    limit_req zone=exploit burst=20 nodelay;

    location / {
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
      proxy_set_header Host $http_host;
      proxy_redirect off;
      proxy_pass http://app_server;
    }
  }
}
